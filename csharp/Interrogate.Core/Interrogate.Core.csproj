<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>Interrogate</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsAotCompatible>true</IsAotCompatible>

    <!-- NuGet packaging -->
    <PackageId>Interrogate.Core</PackageId>
    <Version>1.7.0</Version>
    <Authors>Panda3D</Authors>
    <Description>
      Runtime base classes for C# bindings generated by the interrogate binding
      generator. Provides NativeObject (the base wrapper for C++ heap objects),
      ownership semantics (Borrowed / Owned / RefCounted), and native collection
      helpers used by all interrogate-generated C# assemblies.
    </Description>
    <PackageTags>interrogate;panda3d;bindings;csharp;interop;native;pinvoke</PackageTags>
    <PackageLicenseExpression>BSD-3-Clause</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/Maxwell175/interrogate</PackageProjectUrl>
    <RepositoryUrl>https://github.com/Maxwell175/interrogate</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <IsPackable>true</IsPackable>
    <NoDefaultExcludes>true</NoDefaultExcludes>

    <!-- Set from CI: -p:NativeRuntimesDir=path/with/runtimes/<rid>/native/ layout -->
    <NativeRuntimesDir Condition="'$(NativeRuntimesDir)' == ''">$(MSBuildThisFileDirectory)runtimes</NativeRuntimesDir>
  </PropertyGroup>

  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="README.md" />
  </ItemGroup>

  <!-- Native support libraries, one subdir per RID.  Local dev builds produce
       an empty runtimes/ tree, in which case this block finds nothing.  In CI
       the pack job populates runtimes/<rid>/native/ with shared + static
       artifacts from all platforms before running `dotnet pack`. -->
  <ItemGroup Condition="Exists('$(NativeRuntimesDir)')">
    <None Include="$(NativeRuntimesDir)/**"
          Pack="true"
          PackagePath="runtimes/" />
  </ItemGroup>

  <!-- Transitive MSBuild targets — imported automatically by consuming projects. -->
  <ItemGroup>
    <None Include="Interrogate.Core.targets"
          Pack="true"
          PackagePath="buildTransitive/net8.0/Interrogate.Core.targets" />
  </ItemGroup>
</Project>
