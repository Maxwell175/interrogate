<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>Interrogate</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <PackageId>Interrogate.Core</PackageId>
    <Version>1.0.0</Version>
    <Authors>Panda3D</Authors>
    <Description>Runtime base classes for C# bindings generated by interrogate.</Description>
    <PackageLicenseExpression>BSD-3-Clause</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/panda3d/interrogate</PackageProjectUrl>
    <IsPackable>true</IsPackable>
  </PropertyGroup>
</Project>
